{
  "name": "attic",
  "private": true,
  "version": "3.0.7",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite --port 5175\" \"wait-on http://localhost:5175 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "node scripts/build-electron.cjs",
    "publish:electron": "npm run build && npm run ensure-songsee && electron-builder --win -p always -c.electronDist=node_modules/electron/dist",
    "ensure-songsee": "node scripts/ensure-songsee.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.cjs",
    "test:e2e": "playwright test",
    "download:songsee": "node scripts/download-songsee.cjs",
    "lint": "oxlint",
    "copy-piper-assets": "node scripts/copy-piper-assets.cjs",
    "postinstall": "npm run copy-piper-assets && npm run copy-sherpa-wasm",
    "copy-sherpa-wasm": "node scripts/copy-sherpa-wasm.cjs"
  },
  "build": {
    "appId": "com.attic.audio",
    "productName": "Attic",
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "nsis": "1.2.1"
    },
    "compression": "normal",
    "files": [
      "dist/**/*",
      "!dist/oonx/**/*",
      "!dist/sf2/**/*",
      "electron/*.cjs",
      "package.json",
      "!release*/**/*",
      "!release-build*/**/*",
      "!release-prod*/**/*",
      "!build/**/*",
      "!**/*.dylib",
      "!**/*.so",
      "!**/*.so.*",
      "!**/*.a",
      "!**/.cache/**/*",
      "!**/*.d.ts",
      "!**/*.map",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**/*"
    ],
    "extraResources": [
      {
        "from": "public/oonx",
        "to": "oonx"
      },
      {
        "from": "public/sf2",
        "to": "sf2"
      },
      {
        "from": "bin/songsee",
        "to": "bin/songsee"
      },
      {
        "from": "music collection",
        "to": "music collection"
      },
      {
        "from": "TERMS_OF_USE.txt",
        "to": "TERMS_OF_USE.txt"
      },
      {
        "from": "THIRD_PARTY.md",
        "to": "THIRD_PARTY.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": null
    },
    "asarUnpack": [
      "dist/piper-tts/**/*.wasm",
      "dist/piper-tts/**/*.data"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "license": "TERMS_OF_USE.txt",
      "include": "build/installer.nsh",
      "language": "1033"
    },
    "publish": {
      "provider": "github",
      "owner": "FabienCouprie",
      "repo": "attic"
    }
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "onnxruntime-node": "^1.27.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@magenta/music": "^1.23.1",
    "@playwright/test": "^1.62.0",
    "@siteed/sherpa-onnx.rn": "^1.3.1",
    "@tensorflow/tfjs": "^2.8.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@xyflow/react": "^12.11.2",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "ephone": "^1.0.2",
    "jsdom": "^29.1.1",
    "kokoro-js": "^1.2.1",
    "lamejs": "^1.2.1",
    "libpd-wasm": "^0.1.6",
    "mathjs": "^15.2.0",
    "meyda": "^5.6.3",
    "midi-file": "^1.2.4",
    "node-web-audio-api": "^2.0.0",
    "onnxruntime-web": "^1.21.0",
    "oxlint": "^1.71.0",
    "piper-tts-web": "^1.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resonance-audio": "^1.0.0",
    "seedrandom": "^3.0.5",
    "soundtouchjs": "^0.3.0",
    "tesseract.js": "^7.0.0",
    "time-stretch": "^1.2.1",
    "tonal": "^6.4.3",
    "tone": "^14.9.17",
    "typescript": "~6.0.2",
    "vexflow": "^4.2.5",
    "vite": "^8.1.1",
    "vitest": "^3.1.1",
    "wait-on": "^8.0.3",
    "wavesurfer.js": "^7.12.11"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "brace-expansion": "^5.0.8",
    "minimist": "^1.2.8",
    "protobufjs": "^7.6.5",
    "sharp": "^0.35.3",
    "static-eval": "^2.1.1",
    "uuid": "^11.1.1"
  }
}
