<?xml version="1.0"?>
<!--
  Essai de niveau 1 pour Attic : l'harmonie sans renversement au plus proche, dans un autre
  registre, et ce que les moteurs font de la position fondamentale, des reprises et du groove.
  Chaque choix est unique. Ecrit pour Attic, aucun motif n'est repris des exemples de SoundHelix.
-->
<SoundHelix version="0.9">
  <structure>
    <bars>24</bars>
    <beatsPerBar>4</beatsPerBar>
    <ticksPerBeat>4</ticksPerBeat>
    <maxVelocity>1000</maxVelocity>
  </structure>
  <harmonyEngine class="PatternHarmonyEngine">
    <crossoverPitch>7</crossoverPitch>
    <minimizeChordDistance>false</minimizeChordDistance>
    <chordPattern>Dm/8,Bb6/4,C4/4,+Gm/4,A7/4,Dm4/8,+F/2,C/2,Dm/2,Am6/2,Bb/4,Csus4/2,C/2</chordPattern>
  </harmonyEngine>
  <arrangementEngine class="SimpleArrangementEngine">
    <maxIterations>1000000</maxIterations>
    <minActivityCount>2</minActivityCount>
    <maxActivityCount>5</maxActivityCount>
    <maxActivityChangeCount>2</maxActivityChangeCount>
    <startActivityCounts>2,3</startActivityCounts>
    <stopActivityCounts>3,2</stopActivityCounts>
    <activityVector name="motif_fondamental"><minActive>40</minActive></activityVector>
    <activityVector name="motif_morceau"><minActive>40</minActive></activityVector>
    <activityVector name="arpege_fondamental"><minActive>40</minActive></activityVector>
    <activityVector name="plaque_large"><minActive>40</minActive></activityVector>
    <activityVector name="nappe_rejouee"><minActive>40</minActive><stopShift>-4</stopShift></activityVector>

    <track>
      <instrument>motif_fondamental</instrument>
      <transposition>-12</transposition>
      <velocity>500</velocity>
      <sequenceEngine class="PatternSequenceEngine">
        <normalizeChords>true</normalizeChords>
        <patternRestartMode>chord</patternRestartMode>
        <patternEngine class="StringPatternEngine">
          <string>0/2,2,1,+/2,0/2,-1~/2,-2/2,+/2,(1)*2,-/2</string>
        </patternEngine>
      </sequenceEngine>
      <activityVector>motif_fondamental</activityVector>
    </track>

    <track>
      <instrument>motif_morceau</instrument>
      <sequenceEngine class="PatternSequenceEngine">
        <normalizeChords>false</normalizeChords>
        <patternEngine class="StringPatternEngine">
          <string>(0,1,2)*3,(2,1,0)-1,-/3,4/4:250,+/2</string>
        </patternEngine>
      </sequenceEngine>
      <activityVector>motif_morceau</activityVector>
    </track>

    <track>
      <instrument>arpege_fondamental</instrument>
      <transposition>12</transposition>
      <sequenceEngine class="ArpeggioSequenceEngine">
        <normalizeChords>true</normalizeChords>
        <patternEngines>
          <patternEngine class="StringPatternEngine">
            <string>2,1,0,1,2,3</string>
          </patternEngine>
          <patternEngine class="StringPatternEngine">
            <string ticksPerBeat="2">0,1,2,3,4,5,4,3,2,1</string>
          </patternEngine>
        </patternEngines>
      </sequenceEngine>
      <activityVector>arpege_fondamental</activityVector>
    </track>

    <track>
      <instrument>plaque_large</instrument>
      <velocity>800</velocity>
      <sequenceEngine class="ChordSequenceEngine">
        <offsets>0,2,4</offsets>
        <normalizeChords>false</normalizeChords>
        <patternEngine class="StringPatternEngine">
          <string>-/2,0/2,-/1,0/3,-/2,0~/2,0/4:700</string>
        </patternEngine>
      </sequenceEngine>
      <activityVector>plaque_large</activityVector>
    </track>

    <track>
      <instrument>nappe_rejouee</instrument>
      <sequenceEngine class="PadSequenceEngine">
        <offsets>0,1,2</offsets>
        <velocity>600</velocity>
        <retriggerPitches>true</retriggerPitches>
        <normalizeChords>false</normalizeChords>
      </sequenceEngine>
      <activityVector>nappe_rejouee</activityVector>
    </track>
  </arrangementEngine>

  <player class="MidiPlayer">
    <bpm>96</bpm>
    <transposition>62</transposition>
    <groove>110,90</groove>
    <beforePlayWaitTicks>0</beforePlayWaitTicks>
    <afterPlayWaitTicks>0</afterPlayWaitTicks>
    <device name="device1" clockSynchronization="false">Gervill</device>
    <map instrument="motif_fondamental" device="device1" channel="1" program="33" />
    <map instrument="motif_morceau" device="device1" channel="2" program="12" />
    <map instrument="arpege_fondamental" device="device1" channel="3" program="7" />
    <map instrument="plaque_large" device="device1" channel="4" program="5" />
    <map instrument="nappe_rejouee" device="device1" channel="5" program="90" />
  </player>
</SoundHelix>
